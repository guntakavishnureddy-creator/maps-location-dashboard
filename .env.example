# ==========================================
# CLIENT ENVIRONMENT VARIABLES (client/.env)
# ==========================================

# Google Maps Platform API Key (Required for Google Maps Engine)
# Enable: Maps JavaScript API, Places API, Directions API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

# Default Map Engine ('google' or 'leaflet')
VITE_DEFAULT_MAP_ENGINE=google


# ==========================================
# SERVER ENVIRONMENT VARIABLES (server/.env)
# ==========================================

# Port and environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database URL
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (Neon / Supabase / Render):
# DATABASE_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Google Maps Key (Optional - for server-side proxy / Distance Matrix)
GOOGLE_MAPS_API_KEY=
